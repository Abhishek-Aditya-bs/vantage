{
  // Vantage — full-stack Cloudflare Worker: React SPA assets + Hono API + Durable Objects.
  // Media is stored in the per-space Durable Object's SQLite by default (STORAGE_MODE=do),
  // so the app runs on the pure free tier with NO R2 and NO payment method required.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vantage",
  "main": "./worker/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // Static SPA assets. Unknown non-API paths fall back to index.html (client-side routing).
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },

  "observability": { "enabled": true },

  // Public, non-secret config. Secrets (JWT_SECRET, TURNSTILE_SECRET) come from `wrangler secret`.
  "vars": {
    "APP_NAME": "Vantage",
    "RENDER_MODE": "client", // client (free, on-device WebCodecs) | server (Phase-2 $5 container)
    "STORAGE_MODE": "do", // do (free, DO SQLite) | r2 (optional upgrade once R2 enabled)
    "TURNSTILE_SITE_KEY": "0x4AAAAAADf8WhusAEpPl0Ig" // public site key (client reads it via public/config.js)
  },

  "durable_objects": {
    "bindings": [
      { "name": "SPACE_ROOM", "class_name": "SpaceRoom" },
      { "name": "RATE_LIMITER", "class_name": "RateLimiter" }
      // PHASE-2 / server render — uncomment with the container (needs Workers Paid):
      // , { "name": "RECAP_RENDERER", "class_name": "RecapRenderer" }
    ]
  },

  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SpaceRoom", "RateLimiter"] }
    // PHASE-2 / server render — register the container-backed DO class:
    // , { "tag": "v2", "new_classes": ["RecapRenderer"] }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vantage",
      "database_id": "d81bb56c-142e-4a1d-a01a-7fc9c8814a8e",
      "migrations_dir": "worker/db/migrations"
    }
  ],

  "kv_namespaces": [
    { "binding": "KV", "id": "55d3b00d8bcb4959a016c83e84ba2cf1" }
  ],

  // PHASE-2 / R2 storage — set "STORAGE_MODE": "r2" above, then uncomment. Enabling R2
  // requires a payment method even on its free tier (Cloudflare error 10042):
  // "r2_buckets": [
  //   { "binding": "MEDIA_BUCKET", "bucket_name": "vantage-media" }
  // ],

  // PHASE-2 / server render — the ffmpeg recap Container (needs the Workers Paid plan).
  // See containers/recap-render/README.md for the full enable checklist:
  // "containers": [
  //   {
  //     "class_name": "RecapRenderer",
  //     "image": "./containers/recap-render/Dockerfile",
  //     "max_instances": 2
  //   }
  // ],

  // Workers AI — used for optional image moderation within the 10k neurons/day free budget.
  // Enable by setting "MODERATION_MODE": "on" in vars (optionally "MODERATION_MODEL": "<id>").
  "ai": { "binding": "AI" },

  // Cron: nightly cleanup of inactive/expired spaces (frees DO storage). 1 of 5 free triggers.
  "triggers": { "crons": ["0 3 * * *"] }
}
